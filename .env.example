# Copy this file to .env for local Docker Compose. Never commit .env.

WEBHOOK_HTTP_PORT=8080
WEBHOOK_PRIVATE_KEY_PATH=./secrets/local-only.private.key

AUTOINVENTARIO_API_KEY=CHANGE_ME_WEBHOOK_API_KEY
AUTOINVENTARIO_VERIFY_TOKEN=CHANGE_ME_WEBHOOK_VERIFY_TOKEN

# Required today because the Webhook validates ConnectionStrings:Postgres on startup.
# For a webhook-only PoC that does not use GET /id-clients, keep a non-empty placeholder.
AUTOINVENTARIO_POSTGRES_CONNECTION_STRING=Host=CHANGE_ME_DB_HOST;Port=5432;Database=CHANGE_ME_DB_NAME;Username=CHANGE_ME_DB_USER;Password=CHANGE_ME_DB_PASSWORD

LICENSE_EDITION=Community/Internal
LICENSE_FILE_PATH=local-only/CHANGE_ME.license.json
LICENSE_PUBLIC_KEY_PATH=local-only/CHANGE_ME.license-public.pem
LICENSE_ALLOW_UNSIGNED_DEVELOPMENT=true
