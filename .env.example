# Copy this file to .env for local Docker Compose. Never commit .env.

WEBHOOK_HTTP_PORT=8080
WEBHOOK_PRIVATE_KEY_PATH=./secrets/local-only.private.key

AUTOINVENTARIO_API_KEY=CHANGE_ME_WEBHOOK_API_KEY

# Use Local for the webhook-only flow, or AwsLambda with the AWS_* values below.
INVENTORY_PROCESSING_MODE=Local
AWS_REGION=us-east-1
AUTOINVENTARIO_LAMBDA_NAME=CHANGE_ME_LAMBDA_FUNCTION_NAME

LICENSE_EDITION=Community/Internal
LICENSE_FILE_PATH=local-only/CHANGE_ME.license.json
LICENSE_PUBLIC_KEY_PATH=local-only/CHANGE_ME.license-public.pem
LICENSE_ALLOW_UNSIGNED_DEVELOPMENT=true

MANAGEENGINE_BASE_URL=https://manageengine.example.local
MANAGEENGINE_WORKSTATIONS_PATH=/api/v3/workstations
MANAGEENGINE_TIMEOUT_SECONDS=10
MANAGEENGINE_API_TOKEN=CHANGE_ME_MANAGEENGINE_API_TOKEN

# ConnectionStrings__Postgres is assembled by docker-compose from these values.
POSTGRES_DB=autoinventario
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
