{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "Postgres": "Host=CHANGE_ME_DB_HOST;Port=5432;Database=CHANGE_ME_DB_NAME;Username=CHANGE_ME_DB_USER;Password=CHANGE_ME_DB_PASSWORD"
    },
    "AutoInventario": {
        "ApiKey": "CHANGE_ME_WEBHOOK_API_KEY",
        "VerifyToken": "CHANGE_ME_WEBHOOK_VERIFY_TOKEN"
    },
    "Security": {
        "PrivateKeyPath": "local-only/CHANGE_ME.private.key"
    },
    "InventoryProcessing": {
        "Mode": "AwsLambda",
        "AwsLambda": {
            "FunctionName": "CHANGE_ME_LAMBDA_FUNCTION_NAME",
            "Region": "CHANGE_ME_AWS_REGION"
        }
    },
    "License": {
        "Edition": "Community/Internal",
        "LicenseFilePath": "local-only/CHANGE_ME.license.json",
        "PublicKeyPath": "local-only/CHANGE_ME.license-public.pem",
        "PublicKeyPem": "CHANGE_ME_OR_LEAVE_EMPTY",
        "AllowUnsignedDevelopmentLicense": true,
        "ValidateOnStartup": true,
        "DevelopmentMaxEndpoints": 25,
        "DevelopmentCustomer": "local-only-customer"
    },
    "ManageEngine": {
        "BaseUrl": "https://example.manageengine.local",
        "WorkstationsPath": "/api/v3/workstations",
        "ApiTokenSecretName": "MANAGEENGINE_API_TOKEN",
        "TimeoutSeconds": 10
    }
}
